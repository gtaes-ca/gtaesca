# Copy to .env and fill in values (docker compose loads .env automatically)

# ─── Local development (root docker-compose.yml) ───
# SMTP email delivery (port 587 + STARTTLS, or port 465 + SMTP_SECURE=true)
# Gmail: host smtp.gmail.com, SMTP_PASS = App Password, SMTP_FROM_EMAIL = SMTP_USER
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=GTA Electric Services

ADMIN_URL=http://localhost:5173
WEB_URL=http://localhost:3000
JWT_SECRET=asldkaljlkjadiajlsjdlaksdakjkajskdjkasjdlasjdl
SUPER_ADMIN_EMAIL=superadmin@gtaes.local
SUPER_ADMIN_PASSWORD=Password123

# ─── Production (DigitalOcean droplet) ───
# See deploy/droplet/.env.example and deploy/droplet/README.md
# API URL: https://gtaes.nicheye.com
# Vercel admin: VITE_API_URL=https://gtaes.nicheye.com
# Vercel web:   NEXT_PUBLIC_API_URL=https://gtaes.nicheye.com

