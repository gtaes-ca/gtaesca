# ─── Database (droplet only — not exposed publicly) ───
POSTGRES_USER=gtaes
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=gtaes

# Tip: avoid @ # $ / : in POSTGRES_PASSWORD if you also use DATABASE_URL elsewhere.
# This stack connects with DB_HOST / DB_USER / DB_PASSWORD (special chars are fine).

# ─── API secrets ───
JWT_SECRET=change-me-long-random-jwt-secret
SUPER_ADMIN_EMAIL=superadmin@gtaes.local
SUPER_ADMIN_PASSWORD=ChangeMeSuperAdmin123!

# ─── Public URLs (Vercel frontends) ───
ADMIN_URL=https://gta-electric-services-1.vercel.app
WEB_URL=https://gta-electric-services-1-95zf.vercel.app
CORS_ORIGINS=https://gta-electric-services-1.vercel.app,https://gta-electric-services-1-95zf.vercel.app

# ─── Email (SMTP) ───
# Use port 587 with STARTTLS (SMTP_SECURE=false), or 465 with SSL (true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GTA Electric Services

# ─── Optional ───
JSON_BODY_LIMIT=15mb
