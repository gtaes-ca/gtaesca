# ─── Database (droplet only — not exposed publicly) ───
POSTGRES_USER=gtaes
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=gtaes

# Tip: avoid @ # $ / : in POSTGRES_PASSWORD if you also use DATABASE_URL elsewhere.
# This stack connects with DB_HOST / DB_USER / DB_PASSWORD (special chars are fine).

# ─── API secrets ───
JWT_SECRET=change-me-long-random-jwt-secret
SUPER_ADMIN_EMAIL=superadmin@gtaelectricservices.ca
SUPER_ADMIN_PASSWORD=ChangeMeSuperAdmin123!

# ─── Public URLs ───
# API (this droplet): https://api.gtaelectricservices.ca
# Prefer custom domains for email links once DNS is live.
ADMIN_URL=https://admin.gtaelectricservices.ca
WEB_URL=https://gtaelectricservices.ca
# Exact browser origins allowed to call the API (no trailing slash).
# Include custom domains AND stable Vercel project URLs.
CORS_ORIGINS=https://admin.gtaelectricservices.ca,https://gtaelectricservices.ca,https://www.gtaelectricservices.ca,https://admin-gtaes-git-main-gtaes.vercel.app,https://web-gtaes-git-main-gtaes.vercel.app
# Also allow per-deploy Vercel preview hosts matching https://*-gtaes.vercel.app (set false to disable)
CORS_ALLOW_VERCEL_PREVIEWS=true

# ─── Email (SMTP connection) ───
# Account credentials + From address/name are configured in Admin → CMS → Contact.
# Use port 587 with STARTTLS (SMTP_SECURE=false), or 465 with SSL (true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ─── Optional ───
JSON_BODY_LIMIT=15mb
