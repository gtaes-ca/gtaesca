# ─── Database (droplet only — not exposed publicly) ───
POSTGRES_USER=gtaes
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=gtaes

# ─── API secrets ───
JWT_SECRET=change-me-long-random-jwt-secret
SUPER_ADMIN_EMAIL=superadmin@gtaes.local
SUPER_ADMIN_PASSWORD=ChangeMeSuperAdmin123!

# ─── Public URLs (Vercel frontends) ───
# Replace with your actual Vercel deployment URLs after publishing admin + web.
ADMIN_URL=https://your-admin.vercel.app
WEB_URL=https://your-web.vercel.app

# Comma-separated origins allowed by CORS (must include both Vercel URLs).
CORS_ORIGINS=https://your-admin.vercel.app,https://your-web.vercel.app

# ─── Email (UsePlunk) ───
USEPLUNK_API_KEY=
USEPLUNK_FROM_EMAIL=
USEPLUNK_FROM_NAME=GTA Electric Services
USEPLUNK_API_URL=https://next-api.useplunk.com/v1/send

# ─── Optional ───
JSON_BODY_LIMIT=15mb
